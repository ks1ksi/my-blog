---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { SITE, HOME, SOCIALS } from "@consts";
import ArrowCard from "@components/ArrowCard.astro";
import Link from "@components/Link.astro";
import { getPublishedPosts } from "@lib/content";
import { createWebsiteJsonLd } from "@lib/seo";
const posts = await getPublishedPosts();
const blog = posts.slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);
const jsonLd = createWebsiteJsonLd();
---

<Layout title={HOME.TITLE} description={HOME.DESCRIPTION} jsonLd={jsonLd}>
  <Container size="page">
    <div class="home-stack" data-pagefind-ignore>
      <section class="hero" aria-labelledby="home-title">
        <div>
          <h1 id="home-title">{SITE.TITLE}</h1>
          <p class="hero-description">
            Software Engineer
            <br />
            Kotlin / Spring Boot
          </p>
        </div>
        <nav class="topic-nav" aria-label="주제별로 읽기">
          <p class="eyebrow">주제별로 읽기</p>
          <a href="/tags/cs/">
            컴퓨터 과학 <span aria-hidden="true">↗</span>
          </a>
          <a href="/tags/ps/">
            알고리즘 <span aria-hidden="true">↗</span>
          </a>
          <a href="/tags/life/">
            회고와 일상 <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </section>
      <section aria-labelledby="recent-title">
        <div class="section-heading">
          <h2 id="recent-title">최근 글</h2>
          <Link href="/blog/">
            모든 글 <span aria-hidden="true">→</span>
          </Link>
        </div>
        <ul class="post-list">
          {blog.map((post) => (
            <li>
              <ArrowCard entry={post} heading="h3" />
            </li>
          ))}
        </ul>
      </section>
      <section class="contact-section" aria-labelledby="contact-title">
        <h2 id="contact-title">연락처</h2>
        <ul class="contact-links">
          {SOCIALS.map((social) => (
            <li>
              <Link
                href={social.HREF}
                external
                aria-label={`${SITE.TITLE}의 ${social.NAME} 프로필`}
              >
                {social.NAME} <span aria-hidden="true">↗</span>
              </Link>
            </li>
          ))}
          <li>
            <Link
              href={`mailto:${SITE.EMAIL}`}
              aria-label={`${SITE.TITLE}에게 이메일 보내기`}
            >
              {SITE.EMAIL}
            </Link>
          </li>
        </ul>
      </section>
    </div>
  </Container>
</Layout>
