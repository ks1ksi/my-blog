---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import BackToPrevious from "@components/BackToPrevious.astro";
import { getPublishedPosts } from "@lib/content";
import { getSeriesWithPosts, type PostSeries } from "@lib/discovery";
import { createBreadcrumbJsonLd, getCanonicalUrl } from "@lib/seo";

export async function getStaticPaths() {
  return getSeriesWithPosts(await getPublishedPosts()).map((series) => ({
    params: { id: series.id },
    props: { series },
  }));
}
type Props = { series: PostSeries };
const { series } = Astro.props;
const jsonLd = createBreadcrumbJsonLd([
  { name: "홈", url: getCanonicalUrl("/") },
  { name: series.title, url: getCanonicalUrl(Astro.url.pathname) },
]);
---

<Layout
  title={`${series.title} 시리즈`}
  description={series.description}
  noindex
  jsonLd={jsonLd}
>
  <Container size="article">
    <div data-pagefind-ignore>
      <BackToPrevious href="/#series-title">홈의 시리즈 목록</BackToPrevious>
      <header class="page-heading">
        <p class="eyebrow">시리즈 · {series.posts.length}편</p>
        <h1>{series.title}</h1>
        <p>{series.introduction}</p>
      </header>
      <nav aria-label={`${series.title} 읽기 순서`}>
        {series.groups.map((group, index) => (
          <section
            class="series-group"
            aria-labelledby={`series-group-${index}`}
          >
            <h2 id={`series-group-${index}`}>{group.title}</h2>
            <p>{group.description}</p>
            <ol>
              {group.posts.map((post) => (
                <li>
                  <a href={`/blog/${post.id}/`}>
                    {post.data.title}
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))}
            </ol>
          </section>
        ))}
      </nav>
    </div>
  </Container>
</Layout>

<style>
  .series-group {
    margin-block: var(--space-12);
  }
  .series-group h2 {
    font-size: 1.25rem;
    font-weight: 650;
    line-height: 1.5;
  }
  .series-group p {
    margin-block: var(--space-2) var(--space-4);
    color: var(--color-muted);
    line-height: 1.8;
  }
  ol {
    list-style: none;
    padding: 0;
    border-top: 1px solid var(--color-border);
  }
  li {
    border-bottom: 1px solid var(--color-border);
  }
  li a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    min-height: 44px;
    padding: var(--space-3) var(--space-2);
    color: var(--color-text-strong);
    overflow-wrap: anywhere;
    line-height: 1.7;
  }
  li a:visited {
    color: var(--color-visited);
  }
  li a:hover,
  li a:focus-visible {
    color: var(--color-accent);
    background: var(--color-accent-subtle);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
