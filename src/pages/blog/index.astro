---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { BLOG } from "@consts";
import { getPostsGroupedByYear } from "@lib/content";
import { createBreadcrumbJsonLd, getCanonicalUrl } from "@lib/seo";

const postsByYear = await getPostsGroupedByYear();
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: BLOG.TITLE,
    description: BLOG.DESCRIPTION,
    url: getCanonicalUrl(Astro.url.pathname),
    inLanguage: "ko-KR",
  },
  createBreadcrumbJsonLd([
    { name: "Home", url: getCanonicalUrl("/") },
    { name: "Blog", url: getCanonicalUrl(Astro.url.pathname) },
  ]),
];
const postCount = postsByYear.reduce(
  (total, group) => total + group.posts.length,
  0,
);
---

<Layout title={BLOG.TITLE} description={BLOG.DESCRIPTION} jsonLd={jsonLd}>
  <Container size="page">
    <div data-pagefind-ignore>
      <div class="page-heading">
        <h1>모든 글</h1>
        <p>글 {postCount}개</p>
      </div>
      <div class="archive-years">
        {postsByYear.map(({ year, posts }, yearIndex) => (
          <details
            id={`year-${year}`}
            class="year-section"
            data-year-details
            data-year={year}
            open={yearIndex < 2}
          >
            <summary>
              <h2>{year}</h2>
              <span class="year-count">{posts.length}개</span>
            </summary>
            <ul class="post-list">
              {posts.map((post) => (
                <li>
                  <ArrowCard entry={post} heading="h3" />
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>
    </div>
  </Container>
</Layout>
