---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Giscus from "@components/Giscus.astro";
import { type BlogPost, getPublishedPosts } from "@lib/content";
import {
  createBlogPostingJsonLd,
  createBreadcrumbJsonLd,
  getCanonicalUrl,
  getPostModifiedDate,
  getPostDescription,
  getPostOgImagePath,
} from "@lib/seo";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => ({
    params: { id: post.id },
    props: {
      post,
      prevPost: posts[index - 1],
      nextPost: posts[index + 1],
    },
  }));
}

type Props = {
  post: BlogPost;
  prevPost?: BlogPost;
  nextPost?: BlogPost;
};

const { post, prevPost, nextPost } = Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const description = getPostDescription(post);
const canonicalURL = getCanonicalUrl(Astro.url.pathname);
const modifiedDate = getPostModifiedDate(post);
const imagePath = getPostOgImagePath(post);
const imageURL = new URL(imagePath, Astro.site).href;
const jsonLd = [
  createBlogPostingJsonLd({
    post,
    url: canonicalURL,
    image: imageURL,
    description,
  }),
  createBreadcrumbJsonLd([
    { name: "Home", url: getCanonicalUrl("/") },
    { name: "Blog", url: getCanonicalUrl("/blog") },
    { name: post.data.title, url: canonicalURL },
  ]),
];
---

<Layout
  title={post.data.title}
  description={description}
  image={imagePath}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={modifiedDate}
  tags={post.data.tags}
  jsonLd={jsonLd}
  hasMath={remarkPluginFrontmatter.hasMath === true}
>
  <Container size="article">
    <div>
      <BackToPrevious href="/blog/">모든 글</BackToPrevious>
    </div>
    <div class="article-heading">
      <div class="article-meta">
        <div>
          <FormattedDate date={post.data.date} />
        </div>
        <span aria-hidden="true">&bull;</span>
        {post.body && <div>{readingTime(post.body)}</div>}
      </div>
      <h1 data-pagefind-body data-pagefind-meta="title" class="article-title">
        {post.data.title}
      </h1>
      {post.data.tags && post.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 pt-1">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag-link">
              {tag}
            </a>
          ))}
        </div>
      ) : null}
    </div>
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article data-pagefind-body>
      <Content />
      <div class="mt-16" data-pagefind-ignore>
        <PostNavigation prevPost={prevPost} nextPost={nextPost} />
      </div>
      <div class="mt-16" data-pagefind-ignore>
        <Giscus />
      </div>
    </article>
  </Container>
</Layout>
