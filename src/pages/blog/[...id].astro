---
import { render } from "astro:content";
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrevious from "@components/BackToPrevious.astro";
import PostNavigation from "@components/PostNavigation.astro";
import TableOfContents from "@components/TableOfContents.astro";
import Giscus from "@components/Giscus.astro";
import RelatedPosts from "@components/RelatedPosts.astro";
import { getRelatedPosts, getSeriesNavigation } from "@lib/discovery";
import { type BlogPost, getPublishedPosts } from "@lib/content";
import {
  createBlogPostingJsonLd,
  createBreadcrumbJsonLd,
  getCanonicalUrl,
  getPostModifiedDate,
  getPostDescription,
  getPostOgImagePath,
} from "@lib/seo";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post, index) => {
    const seriesNavigation = getSeriesNavigation(post.id, posts);
    const navigationIds = seriesNavigation
      ? seriesNavigation.series.posts.map((entry) => entry.id)
      : [posts[index - 1]?.id, posts[index + 1]?.id].filter(
          (id): id is string => Boolean(id),
        );
    return {
      params: { id: post.id },
      props: {
        post,
        prevPost: posts[index - 1],
        nextPost: posts[index + 1],
        seriesNavigation,
        relatedPosts: getRelatedPosts(post, posts, 3, navigationIds),
      },
    };
  });
}

type Props = {
  post: BlogPost;
  prevPost?: BlogPost;
  nextPost?: BlogPost;
  seriesNavigation?: ReturnType<typeof getSeriesNavigation>;
  relatedPosts: BlogPost[];
};

const { post, prevPost, nextPost, seriesNavigation, relatedPosts } =
  Astro.props;
const { Content, headings, remarkPluginFrontmatter } = await render(post);
const description = getPostDescription(post);
const canonicalURL = getCanonicalUrl(Astro.url.pathname);
const modifiedDate = getPostModifiedDate(post);
const imagePath = getPostOgImagePath(post);
const imageURL = new URL(imagePath, Astro.site).href;
const jsonLd = [
  createBlogPostingJsonLd({
    post,
    url: canonicalURL,
    image: imageURL,
    description,
  }),
  createBreadcrumbJsonLd([
    { name: "홈", url: getCanonicalUrl("/") },
    { name: "모든 글", url: getCanonicalUrl("/blog") },
    { name: post.data.title, url: canonicalURL },
  ]),
];
---

<Layout
  title={post.data.title}
  description={description}
  image={imagePath}
  type="article"
  publishedTime={post.data.date}
  modifiedTime={modifiedDate}
  tags={post.data.tags}
  jsonLd={jsonLd}
  hasMath={remarkPluginFrontmatter.hasMath === true}
>
  <Container size="article">
    <div>
      <BackToPrevious href="/blog/">모든 글</BackToPrevious>
    </div>
    <div class="article-heading">
      <div class="article-meta">
        <div>
          <FormattedDate date={post.data.date} />
        </div>
        <span aria-hidden="true">&bull;</span>
        {post.body && <div>{readingTime(post.body)}</div>}
      </div>
      <h1 data-pagefind-body data-pagefind-meta="title" class="article-title">
        {post.data.title}
      </h1>
      {post.data.tags && post.data.tags.length > 0 ? (
        <div class="flex flex-wrap gap-2 pt-1">
          {post.data.tags.map((tag) => (
            <a href={`/tags/${tag}/`} class="tag-link">
              {tag}
            </a>
          ))}
        </div>
      ) : null}
    </div>
    {seriesNavigation && (
      <p class="series-context" data-pagefind-ignore>
        <a href={`/series/${seriesNavigation.series.id}/`}>
          {seriesNavigation.series.title} 시리즈
        </a>
        <span>
          {seriesNavigation.series.posts.length}편 중{" "}
          {seriesNavigation.position}번째 글
        </span>
      </p>
    )}
    {headings.length > 0 && <TableOfContents headings={headings} />}
    <article data-pagefind-body>
      <Content />
    </article>
    <div class="mt-16" data-pagefind-ignore>
      <PostNavigation
        prevPost={prevPost}
        nextPost={nextPost}
        seriesNavigation={seriesNavigation}
      />
    </div>
    <RelatedPosts posts={relatedPosts} />
    <div class="mt-16" data-pagefind-ignore>
      <Giscus />
    </div>
  </Container>
</Layout>

<style>
  .series-context {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-1) var(--space-4);
    margin-bottom: var(--space-4);
    color: var(--color-muted);
    font-size: 0.875rem;
  }
  .series-context a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
