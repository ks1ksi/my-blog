---
import Layout from "@layouts/Layout.astro";
import Container from "@components/Container.astro";
import { getTagsWithPosts } from "@lib/content";
import { createBreadcrumbJsonLd, getCanonicalUrl } from "@lib/seo";

const tags = await getTagsWithPosts();
const jsonLd = createBreadcrumbJsonLd([
  { name: "Home", url: getCanonicalUrl("/") },
  { name: "Tags", url: getCanonicalUrl(Astro.url.pathname) },
]);
---

<Layout
  title="Tags"
  description="Seungil Kim 블로그의 글을 태그별로 탐색할 수 있는 색인 페이지."
  noindex
  jsonLd={jsonLd}
>
  <Container size="page">
    <div class="page-heading">
      <h1>태그</h1>
      <p>{tags.length}개</p>
    </div>
    <ul class="tag-index">
      {tags.map(({ tag, count }) => (
        <li>
          <a href={`/tags/${tag}/`}>
            <span>{tag}</span>
            <span class="tag-count">
              {count}편 <span aria-hidden="true">↗</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </Container>
</Layout>
