---
import type { CollectionEntry } from "astro:content";
import { formatDate } from "@lib/utils";
type Props = { entry: CollectionEntry<"blog">; heading?: "h2" | "h3" };
const { entry, heading: Heading = "h2" } = Astro.props;
const tags = entry.data.tags ?? [];
---

<article class="post-card">
  <Heading class="post-card-title">
    <a class="post-link" href={`/${entry.collection}/${entry.id}/`}>
      {entry.data.title}
    </a>
  </Heading>
  <div class="post-card-meta">
    <time datetime={entry.data.date.toISOString()}>
      {formatDate(entry.data.date)}
    </time>
    {tags.length > 0 && <span aria-hidden="true">·</span>}
    {tags.map((tag) => (
      <a href={`/tags/${tag}/`} class="post-tag">
        #{tag}
      </a>
    ))}
  </div>
  {entry.data.description && (
    <p class="post-card-description">{entry.data.description}</p>
  )}
  <span class="post-card-arrow" aria-hidden="true">
    ↗
  </span>
</article>
