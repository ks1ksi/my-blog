---
import { cn } from "@lib/utils";
import type { HTMLAttributes } from "astro/types";
type Props = HTMLAttributes<"a"> & {
  href: string;
  external?: boolean;
  underline?: boolean;
  group?: boolean;
};
const {
  href,
  external,
  underline = true,
  group = false,
  class: className,
  ...rest
} = Astro.props;
---

<a
  href={href}
  target={external ? "_blank" : undefined}
  rel={external ? "noopener noreferrer" : undefined}
  class={cn(
    "text-link",
    !underline && "no-underline",
    group && "group",
    className,
  )}
  {...rest}
>
  <slot />
</a>
