---
import type { PostSeries } from "@lib/discovery";
type Props = { series: PostSeries[] };
const { series } = Astro.props;
---

<ul class="series-overview">
  {series.map((entry) => (
    <li>
      <a href={`/series/${entry.id}/`}>
        <span class="series-title">
          {entry.title} <span aria-hidden="true">→</span>
        </span>
        <span class="series-description">{entry.description}</span>
        <span class="series-count">{entry.posts.length}편의 글</span>
      </a>
    </li>
  ))}
</ul>

<style>
  .series-overview {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    padding: 0;
    list-style: none;
  }
  a {
    display: grid;
    height: 100%;
    gap: var(--space-2);
    padding-block: var(--space-6);
    border-block: 1px solid var(--color-border);
    text-decoration: none;
  }
  a:hover,
  a:focus-visible {
    border-color: var(--color-accent);
  }
  .series-title {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    color: var(--color-text-strong);
    font-size: 1.125rem;
    font-weight: 650;
  }
  a:hover .series-title,
  a:focus-visible .series-title {
    color: var(--color-accent);
  }
  .series-description {
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.75;
  }
  .series-count {
    color: var(--color-muted);
    font-size: 0.8125rem;
  }
  @media (max-width: 40rem) {
    .series-overview {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-4);
    }
  }
</style>
