{
  "name": "astro-micro",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "migrate:velog": "node scripts/migrate-velog.mjs",
    "normalize:tags": "node scripts/normalize-tags.mjs",
    "check:tags": "node scripts/normalize-tags.mjs --check",
    "check:seo": "node scripts/seo-check.mjs",
    "test": "vitest run",
    "build": "astro check && astro build && npm run build:fonts && npm run check:seo && npm run check:content",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check",
    "lint": "prettier --check \"src/**/*.{ts,js,astro,css}\" \"scripts/*.mjs\" astro.config.mjs package.json",
    "check:content": "node scripts/content-check.mjs",
    "build:fonts": "node scripts/subset-fonts.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@pagefind/default-ui": "^1.5.2",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "7.3.5",
    "astro-pagefind": "^2.0.1",
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "pretendard": "^1.3.9",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "satori": "^0.26.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "fontverter": "^2.0.0",
    "pagefind": "^1.5.2",
    "parse5": "^8.0.0",
    "prettier": "^3.8.5",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "subset-font": "^2.9.0",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
